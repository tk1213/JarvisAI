APP_NAME=JarvisAI
APP_ENVIRONMENT=development
DEBUG=false

LOG_LEVEL=INFO

DATABASE_URL=sqlite+aiosqlite:///./jarvis.db

API_HOST=127.0.0.1
API_PORT=8000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_WEB_SEARCH_ENABLED=false

SMART_HOME_PROVIDER=mock

TUYA_ACCESS_ID=
TUYA_ACCESS_KEY=
TUYA_ENDPOINT=https://openapi-sg.iotbing.com

STT_MODEL=base
STT_LANGUAGE=th

TTS_MODEL=gpt-4o-mini-tts
TTS_LANGUAGE=th

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
